  updatedAt       DateTime @updatedAt
}

model WritingSession {
  id                  String                @id @default(auto()) @map("_id") @db.ObjectId
  userId              String                @db.ObjectId
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode                WritingMode
  status              WritingSessionStatus  @default(CREATED)
  
  // Content reference
  topicId             String?               @db.ObjectId
  topic               WritingTopic?         @relation(fields: [topicId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  
  // Session config
  writingDuration     Int?
  wordLimit           Int?
  feedbackLanguage    FeedbackLanguage      @default(TARGET_ONLY)
  evaluationStrictness EvaluationStrictness @default(NORMAL)
  
  // Timestamps
  startedAt           DateTime?
  submittedAt         DateTime?
  processingStartedAt DateTime?
  completedAt         DateTime?
  
  // Content
  writingContent      String?               @db.String
  wordCount           Int?
  characterCount      Int?
  paragraphCount      Int?
  imageUrl            String?
  
  // Scores
  overallScore        Float?
  levelEstimate       CEFRLevel?
  scoreBreakdown      Json?
  taskAchievement     Float?
  coherenceCohesion   Float?
  lexicalResource     Float?
  grammaticalRange    Float?
  organization        Float?
  contentQuality      Float?
  
  // Relations
  feedback            WritingFeedback?
  corrections         WritingCorrection[]
  
  // Metadata
  errorMessage        String?
  modelUsed           String?
  processingDuration  Int?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([userId])
  @@index([userId, mode])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([topicId])
  @@index([status])
}

