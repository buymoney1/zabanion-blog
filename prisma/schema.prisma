generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==================== Enums ====================


enum Accent {
  American
  British
  Australian
  Canadian
  Irish
  Scottish
  NewZealand
  SouthAfrican
  Other
}

enum ContentType {
  Animation
  Movie
  Series
}

enum Difficulty {
  One   @map("1")
  Two   @map("2")
  Three @map("3")
  Four  @map("4")
  Five  @map("5")
  Six   @map("6")
  Seven @map("7")
  Eight @map("8")
  Nine  @map("9")
  Ten   @map("10")
}

enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum ReviewTimePreference {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum PaymentGatewayType {
  ZARINPAL
  AGAYPARDAKHT
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum Role {
  user
  admin
}

// ==================== New AI Speaking Enums ====================

enum SpeakingMode {
  FREE
  TOPIC
  SCENARIO
}

enum SpeakingSessionStatus {
  CREATED
  RECORDING
  PAUSED
  FINISHING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  PARTIAL_COMPLETED
  FAILED_ANALYSIS
}

enum FeedbackLanguage {
  TARGET_ONLY
  MIXED
}

enum EvaluationStrictness {
  NORMAL
  STRICT
  EXAM
}

enum AIProviderType {
  GAPGPT
  OPENAI
  DEEPSEEK
  GEMINI
  CUSTOM
}

enum AITaskType {
  TEXT_GENERATION
  SPEECH_TO_TEXT
  TEXT_TO_SPEECH
  EVALUATION
  TRANSCRIPT_CLEANING
  SUBTITLE_TRANSLATION
}

enum AIConfigStatus {
  ACTIVE
  INACTIVE
  RATE_LIMITED
  ERROR
}

enum ErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CorrectionErrorType {
  GRAMMAR
  VOCABULARY
  COLLOCATION
  WORD_ORDER
  TENSE
  ARTICLE
  PREPOSITION
  PRONUNCIATION_OR_CLARITY
  COHERENCE
  RELEVANCE
  REPETITION
  UNNATURAL_EXPRESSION
  OTHER
}

enum UserSpeakingLevel {
  BEGINNER
  PRE_INTERMEDIATE
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
}

enum SpeakingGoal {
  GENERAL_SPEAKING
  IELTS_SPEAKING
  TRAVEL
  JOB_INTERVIEW
  BUSINESS_ENGLISH
  IMMIGRATION
  ACADEMIC_DISCUSSION
  DAILY_CONVERSATION
  PRESENTATION_PRACTICE
}

// ==================== NextAuth Models ====================

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== User Model ====================

model User {
  id                       String                @id @default(auto()) @map("_id") @db.ObjectId
  name                     String?
  family                   String?
  phone                    String?               @unique
  password                 String?
  email                    String?               @unique
  emailVerified            DateTime?
  image                    String?
  role                     Role                  @default(user)
  referralCode             String?               @unique
  referredById             String?               @db.ObjectId
  directReferralsCount     Int                   @default(0)
  hasPurchasedPackage      Boolean               @default(false)
  packageMonths            Int?
  packageExpiryDate        DateTime?
  notificationEnabled      Boolean               @default(true)
  notificationToken        String?
  lastNotificationAt       DateTime?
  lastReviewNotificationAt DateTime?
  isOnboardingComplete     Boolean               @default(false)
  learningGoal             String?
  targetScore              Float?
  suggestedReviewTime      ReviewTimePreference?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
subtitleTranslationSessions SubtitleTranslationSession[]
    podcastTranslationSessions  PodcastTranslationSession[]
  weeklyPlans         WeeklyPlan[]
  calendarDays        CalendarDay[]
 speakingUsage      UserSpeakingUsage?
 aiQuestionUsage  AIQuestionUsage?
  currentLevel      String?   // 'absolute_beginner' | 'beginner' | ...
  mainChallenge     String[]  // ['forgetting_words', 'speaking_fluency', ...]
  preferredMethod   String[]  // ['flashcards', 'ai_speaking', ...]
  speakingLevel     UserSpeakingLevel?  // رابطه با enum موجود
  xp            Int        @default(0)
  // ===== Ticket & Earnings =====
  tickets             Ticket[]
  assignedTickets     Ticket[]          @relation("AssignedTickets")
  earnings            UserEarning?
  referralsMade       ReferralDetail[]  @relation("ReferrerRefs")
  referredBy          ReferralDetail[]  @relation("ReferredRefs")
  ticketReplies       TicketReply[]
  writingUsage      UserWritingUsage?
  writingOnboarding WritingOnboarding?
  writingSessions   WritingSession[]
  writingProgress   WritingProgress?
  createdWritingTopics WritingTopic[]  @relation("WritingTopicCreator")
  writingCorrections  WritingCorrection[]
  writingSavedWords   WritingSavedWord[]
  exploreReels      ExploreReel[]
  exploreLikes      ExploreLike[]
  exploreComments   ExploreComment[]
  exploreSaves      ExploreSave[]
  exploreViews      ExploreView[]
  // ===== Auth =====
  accounts            Account[]
  sessions            Session[]
plannerOnboardingSkipped   Boolean               @default(false)
  // ===== Payment =====
  transactions        Transaction[]

  discountUsages      DiscountUsage[]
  announcements       Announcement[]     @relation("CreatedAnnouncements")
seoArticles     SeoArticle[]
  cronJobLogs     CronJobLog[]
  // ===== Notifications =====
  notificationLogs    NotificationLog[]
  pushSubscriptions   PushSubscription[]

  // ===== Flashcard =====
  cards               Card[]
  reviews             Review[]

  // ===== Content =====
  notes               Note[]
  mediaFiles          MediaFile[]
  pdfs                PDF[]
  articles            Article[]
  songs               Song[]

  // ===== Activity =====
  activityTrackings   ActivityTracking[]
  dailyActivities     DailyActivity[]

  // ===== Progress =====
  userMovieProgress     UserMovieProgress[]
  userEpisodeProgress   UserEpisodeProgress[]
  podcastProgress       PodcastProgress[]

  // ===== Old Word System =====
  wordLevelProgress     UserLevelProgress[]
  wordChapterProgress   UserChapterProgress[]
  wordPartProgress      UserPartProgress[]
  wordProgress          UserWordProgress[]

  // ===== New Book System =====
  userBookProgress        UserBookProgress[]
  userBookLessonProgress  UserBookLessonProgress[]
  userBookPartProgress    UserBookPartProgress[]
  userBookWordProgress    UserBookWordProgress[]

  // ===== AI Speaking =====
  speakingOnboarding      AISpeakingOnboarding?
  speakingSessions        AISpeakingSession[]
  speakingProgress        AISpeakingProgress?

   // Relation های جدید برای مدل‌های AI Speaking
  createdTopics           SpeakingTopic[]       @relation("TopicCreator")
  createdScenarios        SpeakingScenario[]    @relation("ScenarioCreator")
  speakingCorrections     AISpeakingCorrection[]
  savedWords              SpeakingSavedWord[]


}

// ==================== OTP & Phone Verification ====================

model OTP {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String
  code      String
  type      String
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone, type])
  @@index([phone, expiresAt])
  @@index([phone, type, used, expiresAt])
}

model PhoneVerification {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  phone      String    @unique
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([verified])
}

// ==================== Language Model ====================

model Language {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  code   String  @unique
  name   String
  native String?
  flag   String?
  movies Movie[]
 exploreReels ExploreReel[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== Movie/Video Models ====================

model Movie {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String       @unique
  accent          Accent
  article         String?      @db.String
  description     String?      @db.String
  difficulty      Difficulty   @default(Three)
  image           String?
  bannerImage     String?
  contentType     ContentType
  contentOwner    String?
  duration        Int?
  cefrLevel       CEFRLevel?
  previewMovie    String?
  metaTitle       String?
  metaDescription String?
  faq             Json?        @db.Json
  languageId      String       @db.ObjectId
  language        Language     @relation(fields: [languageId], references: [id])
  episodes        Episode[]
  userProgress    UserMovieProgress[]
  dailyActivities DailyActivity[]
  cards           Card[]
  isPublished     Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  wordOccurrences WordOccurrence[]

  @@index([languageId])
  @@index([contentType])
  @@index([cefrLevel])
  @@index([difficulty])
  @@index([isPublished])
}

model Episode {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  order           Int
  quality         String?
  file            String?
  audioFile       String?
   description     String?  @db.String
  duration        Int?
  subtitleUrl     String?
  movieId         String              @db.ObjectId
  movie           Movie               @relation(fields: [movieId], references: [id], onDelete: Cascade)
  userProgress    UserEpisodeProgress[]
  cards           Card[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  wordOccurrences WordOccurrence[]
isPremium     Boolean              @default(false)
  @@unique([movieId, order])
  @@index([movieId])
}

// ==================== User Progress Models ====================

model UserMovieProgress {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId        String    @db.ObjectId
  movie          Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  isBookmarked   Boolean   @default(false)
  isLocked       Boolean   @default(false)
  progress       Float     @default(0)
  lastAccessedAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, movieId])
  @@index([userId])
  @@index([movieId])
}

model UserEpisodeProgress {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId    String    @db.ObjectId
  episode      Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  lastPosition Float     @default(0)
  timeSpent    Float     @default(0)
  completed    Boolean   @default(false)
  watchedCount Int       @default(1)
  lastWatchedAt DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, episodeId])
  @@index([userId])
  @@index([episodeId])
}

// ==================== Podcast Progress Model ====================

model PodcastProgress {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcastId     Int
  episodeId     Int
  lastPosition  Float    @default(0)
  timeSpent     Float    @default(0)
  completed     Boolean  @default(false)
  listenedCount Int      @default(1)
  lastListenedAt DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, podcastId, episodeId])
  @@index([userId])
  @@index([userId, podcastId])
  @@index([userId, lastListenedAt])
}

// ==================== Flashcard System ====================

model Card {
  id                  String         @id @default(auto()) @map("_id") @db.ObjectId
  front               String
  back                String
  hint                String?
  pronunciation       String?
  example             String?
  exampleTranslation  String?
  leitnerBox          Int            @default(1)
  timesSeen           Int            @default(0)
  successStreak       Int            @default(0)
  failCount           Int            @default(0)
  lastReviewedAt      DateTime?
  nextReviewAt        DateTime       @default(now())
  reviewStatus        String         @default("new")
  isLearned           Boolean        @default(false)
  userId              String         @db.ObjectId
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType          String?
  movieId             String?        @db.ObjectId
  movie               Movie?         @relation(fields: [movieId], references: [id])
  episodeId           String?        @db.ObjectId
  episode             Episode?       @relation(fields: [episodeId], references: [id])
  videoFile           String?
  podcastId           String?
  podcastEpisodeId    String?
  subtitleStart       Float?
  subtitleEnd         Float?
  sentenceText        String?
  sentenceTranslation String?
  wordIndex           Int?
  grammaticalJson     Json?          @db.Json
  audioFile           String?
  reviews             Review[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([userId, leitnerBox])
  @@index([userId, nextReviewAt])
  @@index([userId, reviewStatus])
  @@index([userId, isLearned])
  @@index([movieId])
  @@index([episodeId])
  @@index([podcastId])
  @@index([podcastEpisodeId])
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  isCorrect Boolean
  cardId    String   @db.ObjectId
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== Content Models ====================

model Article {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  content         String
  excerpt         String?
  coverUrl        String?
  level           CEFRLevel
  readingTime     Int?
  vocabularies    ArticleVocabulary[]
  isPublished     Boolean             @default(false)
  createdById     String?             @db.ObjectId
  createdBy       User?               @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  dailyActivities DailyActivity[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model ArticleVocabulary {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  articleId String  @db.ObjectId
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  word      String
  meaning   String
  paragraph Int?
}

model Song {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  artist          String
  album           String?
  duration        Int
  audioUrl        String
  coverUrl        String?
  lyrics          String
  isPublished     Boolean         @default(false)
  createdById     String?         @db.ObjectId
  createdBy       User?           @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  dailyActivities DailyActivity[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([title])
  @@index([artist])
  @@index([createdById])
}

model PodcastMeta {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  podcastId   Int      @unique
  title       String
  slug        String   @unique
  jsonUrl     String
  coverUrl    String?
  level       String   @default("C1")
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
}

model PDF {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  fileUrl     String
  coverUrl    String?
  createdById String?  @db.ObjectId
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
}

// ==================== Activity & Tracking ====================

model DailyActivity {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime
  videoWatched    Boolean  @default(false)
  podcastListened Boolean  @default(false)
  wordsReviewed   Boolean  @default(false)
  articleRead     Boolean  @default(false)
  songListened    Boolean  @default(false)
  videoId         String?  @db.ObjectId
  video           Movie?   @relation(fields: [videoId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  articleId       String?  @db.ObjectId
  article         Article? @relation(fields: [articleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  songId          String?  @db.ObjectId
  song            Song?    @relation(fields: [songId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  progress        Float    @default(0)
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model ActivityTracking {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType String
  contentId    String?
  duration     Int
  pathname     String?
  isRegistered Boolean   @default(false)
  registeredAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([activityType])
  @@index([createdAt])
  @@index([isRegistered])
  @@index([userId, isRegistered])
}

// ==================== Notification & Storage ====================

model NotificationLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("reminder")
  status    String   @default("sent")
  sentAt    DateTime @default(now())
  pushToken String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sentAt])
  @@index([status])
  @@index([type])
}

model PushSubscription {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  keys      Json
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([endpoint])
  @@index([userId])
}

model Note {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  content    String
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  highlights Json?    @db.Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model MediaFile {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  fileName      String    @unique
  originalName  String
  fileType      String
  mimeType      String
  fileSize      Int
  fileSizeMB    Float
  storageKey    String
  publicUrl     String?
  signedUrl     String?
  urlExpiresAt  DateTime?
  isPublic      Boolean   @default(false)
  accessLevel   String    @default("private")
  duration      Int?
  dimensions    String?
  resolution    String?
  uploaderId    String?   @db.ObjectId
  uploader      User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tags          String[]
  category      String?
  views         Int       @default(0)
  downloads     Int       @default(0)
  lastAccessedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([fileType])
  @@index([isPublic])
  @@index([uploaderId])
  @@index([createdAt])
  @@index([tags])
}

// ==================== Old Word Learning System (Legacy) ====================

model Level {
  id           String               @id @default(auto()) @map("_id") @db.ObjectId
  name         CEFRLevel
  title        String
  description  String?
  order        Int
  chapters     Chapter[]
  userProgress UserLevelProgress[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model Chapter {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  order        Int
  levelId      String                @db.ObjectId
  level        Level                 @relation(fields: [levelId], references: [id], onDelete: Cascade)
  parts        Part[]
  userProgress UserChapterProgress[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([levelId, order])
}

model Part {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  title        String?
  order        Int
  chapterId    String             @db.ObjectId
  chapter      Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  words        Word[]
  userProgress UserPartProgress[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([chapterId, order])
}

model Word {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  text         String
  phonetic     String?
  partOfSpeech String?
  meanings     Json
  synonyms     String[]
  antonyms     String[]
  partId       String            @db.ObjectId
  part         Part              @relation(fields: [partId], references: [id], onDelete: Cascade)
  order        Int
  tags         String[]
  userProgress UserWordProgress[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model UserLevelProgress {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  levelId        String    @db.ObjectId
  level          Level     @relation(fields: [levelId], references: [id], onDelete: Cascade)
  totalParts     Int       @default(0)
  completedParts Int       @default(0)
  totalWords     Int       @default(0)
  learnedWords   Int       @default(0)
  progress       Int       @default(0)
  lastStudied    DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, levelId])
}

model UserChapterProgress {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId      String    @db.ObjectId
  chapter        Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  totalParts     Int       @default(0)
  completedParts Int       @default(0)
  totalWords     Int       @default(0)
  learnedWords   Int       @default(0)
  progress       Int       @default(0)
  lastStudied    DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, chapterId])
}

model UserPartProgress {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  partId         String    @db.ObjectId
  part           Part      @relation(fields: [partId], references: [id], onDelete: Cascade)
  isCompleted    Boolean   @default(false)
