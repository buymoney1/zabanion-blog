  feedbackLanguage    FeedbackLanguage      @default(TARGET_ONLY)
  evaluationStrictness EvaluationStrictness @default(NORMAL)

  // Timestamps
  startedAt           DateTime?
  pausedAt            DateTime?
  resumedAt           DateTime?
  finishedAt          DateTime?
  processingStartedAt DateTime?
  completedAt         DateTime?

  // Audio
  audioUrl            String?
  audioDuration       Float?
  audioSize           Int?

  // Transcript
  transcriptRaw       String?               @db.String
  transcriptClean     String?               @db.String
  transcriptConfidence Float?
  wordCount           Int?
  languageDetected    String?

  // Scores
  overallScore        Float?
  levelEstimate       CEFRLevel?
  scoreBreakdown      Json?
  fluencyScore        Float?
  grammarScore        Float?
  vocabularyScore     Float?
  coherenceScore      Float?
  relevanceScore      Float?
  clarityScore        Float?

  // Relations
  feedback            AISpeakingFeedback?
  corrections         AISpeakingCorrection[]

  // Retry system - ساده‌شده برای MongoDB
  retryOf             String?               @db.ObjectId
  retryCount          Int                   @default(0)

  // Metadata
  errorMessage        String?
  modelUsed           String?
  processingDuration  Int?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([userId, mode])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([topicId])
  @@index([scenarioId])
  @@index([status])
  @@index([retryOf])
}

