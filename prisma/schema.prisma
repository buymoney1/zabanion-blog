// ==================== Explore/Reels Models ====================

model ExploreReel {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String?
  description   String?   @db.String
  slug          String    @unique
  
  // Media
  mediaType     String    @default("video") // video | image
  mediaUrl      String                       // m3u8 link for video, image url for image
  thumbnailUrl  String?                      // poster/thumbnail
  folderPath    String?                      // cloud folder path: explore/reelsId/
  
  // Content
  subtitlesJson Json?     @db.Json           // subtitle data like podcasts
  duration      Int?                         // in seconds
  width         Int?                         // 1080
  height        Int?                         // 1920 (9:16 ratio)
  
  // Categorization
  categoryId    String?   @db.ObjectId
  category      ExploreCategory? @relation(fields: [categoryId], references: [id])
  languageId    String?   @db.ObjectId
  language      Language? @relation(fields: [languageId], references: [id], onDelete: SetNull)
  level         CEFRLevel?
  
  // Engagement
  viewCount     Int       @default(0)
  likeCount     Int       @default(0)
  commentCount  Int       @default(0)
  saveCount     Int       @default(0)
  shareCount    Int       @default(0)
  
  // Status
  isPublished   Boolean   @default(false)
  isPremium     Boolean   @default(false)
  
  // Relations
  likes         ExploreLike[]
  comments      ExploreComment[]
  saves         ExploreSave[]
  views         ExploreView[]
  
  createdById   String?   @db.ObjectId
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isPublished])
  @@index([categoryId])
  @@index([languageId])
  @@index([level])
  @@index([createdAt(sort: Desc)])
  @@index([likeCount(sort: Desc)])
  @@index([viewCount(sort: Desc)])
}

